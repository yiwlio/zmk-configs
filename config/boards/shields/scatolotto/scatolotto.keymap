#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layers
#define DEFAULT 0
#define FN 1

/ {  
  keymap {
    compatible = "zmk,keymap";

    /* Default Layer
     * .---------------------------.
     * |  ENC | XIAO | CALC |  FN  |
     * |------+------+------+------|
     * |  DEL |   /  |   *  |   -  |
     * |------+------+------+------|
     * |   7  |   8  |   9  |      |
     * |------+------+------+   +  |
     * |   4  |   5  |   6  |      |
     * |------+------+------+------|
     * |   1  |   2  |   3  |   E  |
     * |------+------+------|   N  |
     * |      0      |   ,  |   T  |
     * '---------------------------'
     */

    default_layer {
      bindings = <
        &kp Z    &kp M    &kp K
        &kp A    &kp B    &kp C
        &kp D    &kp E    &kp F
      >;

      sensor-bindings = <
        &inc_dec_kp LS(Z) LS(A)
      >;
    }; 
    
    /* Function Layer
     * .---------------------------.
     * | ENC  | XIAO |      |      |
     * |------+------+------+------|
     * | BT-C |      |      | BOOT |
     * |------+------+------+------|
     * |      |      |      | OUT  |
     * |------+------+------+      |
     * | BT-3 | BT-4 |      | USB  |
     * |------+------+------+------|
     * | BT-0 | BT-1 | BT-2 | OUT  |
     * |------+------+------|      |
     * |             |      | BLE  |
     * '---------------------------'
     */
    
  };
};
